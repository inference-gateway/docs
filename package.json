{
  "name": "inference-gateway-docs",
  "version": "0.6.23",
  "private": true,
  "description": "Documentation site for Inference Gateway.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .vitepress",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore .vitepress --fix",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "markdownlint-cli": "^0.50.0",
    "mermaid": "^12.3.0",
    "prettier": "^3.10.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.45"
  }
}
